# Auth.js — required. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google sign-in. Without these the provider is not registered and the
# sign-in button is hidden; the site still builds and runs.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Canonical origin. Netlify sets URL automatically for deploy previews.
NEXT_PUBLIC_SITE_URL=https://yuzuch.dev

# --- Orders -----------------------------------------------------------------
# Where a submitted order is POSTed as JSON. Anything that accepts a JSON body
# works: the hospital's HIS, a mail service, an automation endpoint.
#
# Leave EMPTY and the site still accepts orders — it stores them in the
# patient's browser, reports delivered:false, and the confirmation tells them to
# phone the clinic. Set it and the same confirmation says the order was sent.
# Nothing else changes.
#
# Payload shape: src/lib/order-schema.ts (OutboundOrder)
ORDERS_WEBHOOK_URL=
# Optional. Sent as `Authorization: Bearer <token>`.
ORDERS_WEBHOOK_TOKEN=
